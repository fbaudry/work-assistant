{
  "name": "work-assistant",
  "productName": "Work Assistant",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0 <23" },
  "description": "Un espace de travail personnel pour macOS, construit progressivement avec l’IA.",
  "author": "Florian Baudry",
  "license": "UNLICENSED",
  "main": "electron/main.cjs",
  "distribution": "local",
  "repository": { "type": "git", "url": "https://github.com/fbaudry/work-assistant.git" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:desktop": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test electron/*.test.cjs scripts/*.test.mjs",
    "build": "npm run typecheck && vite build",
    "check": "npm test && npm run build",
    "package:local": "npm run build && electron-builder --mac --arm64 --dir --publish never -c.mac.identity=null -c.mac.notarize=false",
    "package:release": "npm run build && electron-builder --mac --arm64 --publish never -c.forceCodeSigning=true",
    "version:ci": "node scripts/version.mjs"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
